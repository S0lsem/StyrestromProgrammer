# Token / secrets — never commit this
mrs_protocol/config.py
# GitHub token used by release.ps1 to publish releases — never commit this
.github_token

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# PyInstaller output
dist/
build/

# IDE
.vscode/
.idea/

# Runtime data — machine-local, generated by the app at flash time
flash_log.csv
flash_report_*.txt

# CAN traces — bench captures saved from the trace pane or PCAN-View. Useful
# while debugging a module, but they are per-session scratch, not source.
*.trc
"MRS Log TRC/"

# Dropped into the working directory by the MRS .NET flasher when it runs
log4net.config

# Server-side account store + local DB — never commit (lives on the proxy)
server/users.json
server/events.db

# Server-side firmware mirror (created at runtime on the server)
server/firmware_mirror/
server/firmware_mirror.old/
